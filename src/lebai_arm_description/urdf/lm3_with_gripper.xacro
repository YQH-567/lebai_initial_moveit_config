<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lebai_lm3">
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="use_camera" default="true"/>
  <xacro:arg name="camera_xyz" default="0.04 0.08 0.04"/>
  <xacro:arg name="camera_rpy" default="0 -1.57079632679 0"/>

  <xacro:include filename="$(find lebai_arm_description)/urdf/lm3_macro.xacro"/>
  <xacro:include filename="$(find lebai_gripper_description)/urdf/gripper_macro.xacro"/>
  <xacro:include filename="$(find lebai_arm_description)/urdf/hand_camera.xacro"/>
  <xacro:include filename="$(find lebai_arm_description)/urdf/lebai.ros2_control.xacro"/>

  <link name="world"/>
  <xacro:lebai_lm3 prefix=""/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- The gripper macro owns its attachment joint. -->
  <xacro:lebai_gripper prefix="" parent="tool0" use_mimic="true"
                       use_ros2_control="false"/>

  <xacro:if value="$(arg use_camera)">
    <xacro:lebai_hand_camera parent="tool0"
      xyz="$(arg camera_xyz)" rpy="$(arg camera_rpy)"
      enable_sensor="$(arg use_gazebo)"/>
  </xacro:if>

  <xacro:lebai_ros2_control name="lebai_lm3"
    use_fake_hardware="$(arg use_fake_hardware)"
    use_gazebo="$(arg use_gazebo)"/>

  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find lebai_arm_description)/config/gz_ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
