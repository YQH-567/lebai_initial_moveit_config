<?xml version="1.0"?>
<robot name="standalone_lebai_gripper_gz" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find lebai_gripper_description)/urdf/gripper_macro.xacro"/>

  <link name="world"/>

  <xacro:lebai_gripper
    prefix=""
    parent="world"
    xyz="0 0 0"
    rpy="0 0 0"
    mesh_package="lebai_gripper_description"
    use_mimic="true"
    use_ros2_control="true"/>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find lebai_gripper_description)/config/gripper_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
